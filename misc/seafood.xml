<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="seafood" _name="SeaFood" version="1.0">
  <author>Ruben Labruyere</author>
  <_description>Color scheme based on the Tango color palette</_description>

  <!-- Palette -->

  <!-- Global Settings -->
  <style name="line-numbers"                background="#rgba(18,20,21,0.005)"/>
  <style name="current-line"                background="#444444"/>
  <style name="current-line-number"         background="#555555"/>
  <style name="draw-spaces"                 foreground="#babdb6"/>
  <style name="background-pattern"          background="#f3f3f3"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               background="#303030" />
  <style name="bracket-mismatch"            foreground="#8a2c25" background="#333333" />

  <!-- Right Margin -->
  <style name="right-margin"                foreground="#2e3436" background="#2e3436"/>

  <!-- Search Matching -->
  <style name="search-match"                background="#63603f"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="#19911b"/>
  <style name="def:shebang"                 foreground="#4e9a06" bold="true"/>
  <style name="def:doc-comment-element"     italic="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="#ad7fa8"/>
  <style name="def:special-char"            foreground="#ad7fa8"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="#188777"/>

  <!-- Statements -->
  <style name="def:statement"               foreground="#188777" bold="true"/>

  <!-- Types -->
  <style name="def:type"                    foreground="#4e9a06" bold="true"/>

  <!-- Markup -->
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         foreground="#a40000" bold="true"/>
  <style name="def:inline-code"             foreground="#3465a4"/>
  <style name="def:insertion"               underline="single"/>
  <style name="def:deletion"                strikethrough="true"/>
  <style name="def:link-text"               foreground="#4e9a06"/>
  <style name="def:link-symbol"             foreground="#4e9a06" bold="true"/>
  <style name="def:link-destination"        italic="true" underline="single"/>
  <style name="def:heading"                 foreground="#4e9a06" bold="true"/>
  <style name="def:thematic-break"          foreground="#4e9a06" bold="true"/>
  <style name="def:preformatted-section"    foreground="#3465a4"/>
  <style name="def:list-marker"             foreground="#a40000" bold="true"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="#188777" bold="true"/>
  <style name="def:error"                   background="#cc0000" bold="true"/>
  <style name="def:warning"                 background="#ad7fa8"/>
  <style name="def:note"                    background="#fcaf3e" bold="true"/>
  <style name="def:net-address"             italic="true" underline="single"/>

  <!-- Heading styles, uncomment to enable -->
  <!--
  <style name="def:heading0"                scale="5.0"/>
  <style name="def:heading1"                scale="2.5"/>
  <style name="def:heading2"                scale="2.0"/>
  <style name="def:heading3"                scale="1.7"/>
  <style name="def:heading4"                scale="1.5"/>
  <style name="def:heading5"                scale="1.3"/>
  <style name="def:heading6"                scale="1.2"/>
  -->

  <!-- Language specific -->
  <style name="diff:added-line"             foreground="#4e9a06"/>
  <style name="diff:removed-line"           foreground="#188777"/>
  <style name="diff:changed-line"           use-style="def:preprocessor"/>
  <style name="diff:diff-file"              use-style="def:type"/>
  <style name="diff:location"               use-style="def:statement"/>
  <style name="diff:special-case"           use-style="def:constant"/>

  <style name="xml:tags"                    foreground="#4e9a06"/>
  <style name="xml:namespace"               bold="true"/>

  <style name="js:built-in-constructor"     foreground="#4e9a06"/>

  <style name="latex:display-math"          foreground="#188777"/>
  <style name="latex:command"               foreground="#4e9a06" bold="true"/>
  <style name="latex:include"               use-style="def:preprocessor"/>
  <style name="latex:special-char"          use-style="def:constant"/>

  <style name="sh:variable"                 foreground="#188777"/>
  <style name="sh:variable-definition"      foreground="#4e9a06"/>

</style-scheme>
